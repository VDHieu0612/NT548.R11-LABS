terraform {
  # Cross-variable validation requires Terraform 1.9 or newer.
  # CI uses the exact version recorded in .terraform-version.
  required_version = ">= 1.9.0, < 2.0.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
}
