# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Sensitive variables
*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# SSH Keys
*.pem
*.key
*.pub
id_rsa*

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Word temp files
~$*.docx
